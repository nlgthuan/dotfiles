#!/usr/bin/env bash
#
# ts: pick one of my Jira tickets with fzf, then create or reuse
# its git worktree, tmux session, Fork tab and IntelliJ window.
#
#   branch:   ts/<number>_<short_name>
#   worktree: $TS_ROOT/worktrees/<number>_<short_name>
#   tmux:     session <number>_<short_name>, two side-by-side panes
#
# Jira credentials:
#   JIRA_EMAIL      defaults to `git config user.email`
#   JIRA_API_TOKEN  or a keychain entry, created once by copying the token and running:
#                   security add-generic-password -U -a "$USER" -s jira-api-token -w "$(pbpaste)"
#                   (not the interactive -w prompt: it truncates input to 128 characters)
#                   (token from https://id.atlassian.com/manage-profile/security/api-tokens)

set -euo pipefail

TS_ROOT="${TS_ROOT:-$HOME/work/teamscale}"
MAIN_REPO="$TS_ROOT/repository"
WORKTREES_DIR="$TS_ROOT/worktrees"
JIRA_URL="${JIRA_URL:-https://cqse.atlassian.net}"
JIRA_JQL="${JIRA_JQL:-assignee = currentUser() AND project = TS AND status in (Backlog, \"In Development\", \"In Review\", Rework) ORDER BY updated DESC}"
TICKETS_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/ts/tickets.tsv"
TODAY_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/ts/today.tsv"
TODAY_TTL="${TS_TODAY_TTL:-300}"
REQUIRED_TOOLS=(git tmux fzf jq curl idea fork)

die() { echo "ts: $*" >&2; exit 1; }

usage() {
	cat <<EOF
Usage: ts [command]

Pick one of your Jira tickets with fzf, then create or reuse its git worktree,
tmux session, Fork tab and IntelliJ window.

Commands:
  (none)            run the ticket picker on the stored tickets
                    (fetches them first if none are stored yet)
                    enter: start, ctrl-o: open in Jira, ctrl-r: refresh from Jira
  <number>, TS-<number>
                    start that ticket directly, without the picker
  master            open the main repository the same way (tmux session
                    'master', Fork, IntelliJ); also the first picker entry
  fetch             fetch your tickets from Jira and store them in
                    $TICKETS_FILE
  open [ticket]     open the ticket in the browser (default: the ticket of the
                    current worktree's branch)
  time [days]       list the time you logged per day and ticket over the last
                    <days> days, today included (default: 7)
  today [--tmux]    print the total time you logged today, e.g. "3h 15m";
                    --tmux prints the cached total instead, with its age dimmed
                    (e.g. "3h 15m ↻4m"), and refreshes it in the background
                    once it is older than TS_TODAY_TTL seconds (default: 300)
  clean             pick worktrees to remove, together with their branch and
                    tmux session
  healthcheck       check required tools, repository and Jira credentials
  help, -h, --help  show this help

Environment:
  TS_ROOT           teamscale folder (default: ~/work/teamscale)
  JIRA_URL          Jira site (default: https://cqse.atlassian.net)
  JIRA_JQL          ticket query (default: your TS tickets in Backlog,
                    In Development, In Review or Rework)
  JIRA_EMAIL        Jira login (default: git config user.email)
  JIRA_API_TOKEN    Jira API token (default: keychain entry 'jira-api-token')
EOF
}

load_jira_credentials() {
	jira_email="${JIRA_EMAIL:-$(git config user.email || true)}"
	jira_token="${JIRA_API_TOKEN:-$(security find-generic-password -s jira-api-token -w 2>/dev/null || true)}"
}

require_jira_credentials() {
	load_jira_credentials
	[[ -n "$jira_email" && -n "$jira_token" ]] || die "missing Jira credentials; run 'ts healthcheck'"
}

# curl with Jira credentials, passed as config on stdin to keep the token out of `ps`.
jira_curl() {
	printf 'user = "%s:%s"\n' "$jira_email" "$jira_token" | curl -K - "$@"
}

# Turns "123", "TS-123" or "ts-123" into "TS-123"; fails for anything else.
parse_key() {
	local number
	number=$(tr '[:lower:]' '[:upper:]' <<<"$1")
	number="${number#TS-}"
	[[ "$number" =~ ^[0-9]+$ ]] || return 1
	echo "TS-$number"
}

# Prints the worktree path of the first branch ts/<number>_*, if any.
# Reads `git worktree list --porcelain` output from stdin.
find_worktree() {
	awk -v prefix="branch refs/heads/ts/$1_" '
		/^worktree / { path = substr($0, 10) }
		index($0, prefix) == 1 { print path; exit }'
}

# Prints the stored status of a ticket, if it is among the stored tickets.
stored_status() {
	[[ -f "$TICKETS_FILE" ]] || return 0
	awk -F'\t' -v k="$1" '$1 == k { print $2 }' "$TICKETS_FILE"
}

# Turns a summary into a short_name: drops a "Component:" prefix, keeps 3 words.
slugify() {
	echo "$1" | sed -E 's/^[^:]{1,30}: *//' | tr '[:upper:]' '[:lower:]' \
		| sed -E 's/[^a-z0-9]+/_/g; s/^_+//; s/_+$//' | cut -d_ -f1-3
}

# --- healthcheck -------------------------------------------------------------

healthcheck() {
	local failures=0
	ok() { printf '  \033[32m✓\033[0m %s\n' "$1"; }
	fail() { printf '  \033[31m✗\033[0m %s\n' "$1"; failures=$((failures + 1)); }

	echo "Tools"
	for cmd in "${REQUIRED_TOOLS[@]}"; do
		if command -v "$cmd" >/dev/null; then ok "$cmd"; else fail "$cmd not found on PATH"; fi
	done

	echo "Repository"
	if git -C "$MAIN_REPO" rev-parse --git-dir >/dev/null 2>&1; then
		ok "main repository $MAIN_REPO"
	else
		fail "no git repository at $MAIN_REPO (set TS_ROOT)"
	fi
	if [[ -d "$WORKTREES_DIR" ]]; then ok "worktrees folder $WORKTREES_DIR"; else fail "missing $WORKTREES_DIR"; fi

	echo "Jira"
	load_jira_credentials
	if [[ -n "$jira_email" ]]; then ok "email $jira_email"; else fail "no email (set JIRA_EMAIL)"; fi
	if [[ -z "$jira_token" ]]; then
		fail "no API token (set JIRA_API_TOKEN or add the 'jira-api-token' keychain entry, see header of $0)"
	else
		ok "API token found (${#jira_token} characters)"
		local status
		status=$(jira_curl -sS -o /dev/null -w '%{http_code}' "$JIRA_URL/rest/api/3/myself" 2>/dev/null) || status="unreachable"
		if [[ "$status" == 200 ]]; then
			ok "authenticated at $JIRA_URL"
		else
			fail "authentication at $JIRA_URL failed (HTTP $status); the token is probably invalid, truncated or expired"
		fi
	fi

	echo
	if ((failures == 0)); then
		echo "All checks passed."
	else
		echo "$failures check(s) failed."
		return 1
	fi
}

# --- fetch -------------------------------------------------------------------

# Stores the tickets as "<key>\t<status>\t<summary>" lines in $TICKETS_FILE.
fetch() {
	require_jira_credentials

	local response
	response=$(jira_curl -fsS \
		-H 'Content-Type: application/json' \
		-X POST "$JIRA_URL/rest/api/3/search/jql" \
		-d "$(jq -n --arg jql "$JIRA_JQL" '{jql: $jql, fields: ["summary", "status"], maxResults: 100}')") \
		|| die "Jira request failed; run 'ts healthcheck'"

	local tickets
	tickets=$(jq -r '.issues[] | [.key, .fields.status.name, .fields.summary] | @tsv' <<<"$response")
	# Jira answers searches with bad credentials as anonymous, which also gives an empty result.
	# Keep the stored tickets in that case.
	[[ -n "$tickets" ]] || die "no tickets found; if that is unexpected, run 'ts healthcheck'"

	mkdir -p "$(dirname "$TICKETS_FILE")"
	printf '%s\n' "$tickets" >"$TICKETS_FILE.tmp"
	mv "$TICKETS_FILE.tmp" "$TICKETS_FILE"
	echo "Stored $(wc -l <"$TICKETS_FILE" | tr -d ' ') tickets in $TICKETS_FILE"
}

# --- open --------------------------------------------------------------------

open_ticket() {
	local key branch
	if [[ -n "$1" ]]; then
		key=$(parse_key "$1") || die "not a ticket: $1"
	else
		branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || die "not in a git repository; pass a ticket"
		[[ "$branch" =~ ^ts/([0-9]+)_ ]] || die "branch '$branch' is not a ts/<number>_<name> branch; pass a ticket"
		key="TS-${BASH_REMATCH[1]}"
	fi
	open "$JIRA_URL/browse/$key"
}

# --- time --------------------------------------------------------------------

# Prints "<day>\t<key>\t<seconds>\t<summary>" for each worklog you logged since <since> (YYYY-MM-DD).
worklog_records() {
	local since="$1"
	require_jira_credentials

	local since_ms me
	since_ms=$(($(date -j -f '%Y-%m-%d %H:%M:%S' "$since 00:00:00" +%s) * 1000))
	me=$(jira_curl -fsS "$JIRA_URL/rest/api/3/myself" | jq -r '.accountId') \
		|| die "Jira request failed; run 'ts healthcheck'"

	local response
	response=$(jira_curl -fsS \
		-H 'Content-Type: application/json' \
		-X POST "$JIRA_URL/rest/api/3/search/jql" \
		-d "$(jq -n --arg jql "worklogAuthor = currentUser() AND worklogDate >= \"$since\" ORDER BY key" \
			'{jql: $jql, fields: ["summary", "worklog"], maxResults: 100}')") \
		|| die "Jira request failed; run 'ts healthcheck'"

	# Prints "<day>\t<key>\t<seconds>\t<summary>" for each of my worklogs since $since.
	local my_worklogs='.[] | select(.author.accountId == $me and .started[0:10] >= $since)
		| [(.started[0:10] | strptime("%Y-%m-%d") | mktime | strftime("%a %Y-%m-%d")), $key, .timeSpentSeconds, $summary]
		| @tsv'

	# The search includes at most 20 worklogs per ticket; fetch the rest separately.
	local records incomplete key summary
	records=$(jq -r --arg me "$me" --arg since "$since" '.issues[]
		| select(.fields.worklog.total <= (.fields.worklog.worklogs | length))
		| .key as $key | .fields.summary as $summary | .fields.worklog.worklogs | '"$my_worklogs" <<<"$response")
	incomplete=$(jq -r '.issues[]
		| select(.fields.worklog.total > (.fields.worklog.worklogs | length))
		| [.key, .fields.summary] | @tsv' <<<"$response")
	while IFS=$'\t' read -r key summary; do
		[[ -n "$key" ]] || continue
		records+=$'\n'$(jira_curl -fsS "$JIRA_URL/rest/api/3/issue/$key/worklog?startedAfter=$since_ms" \
			| jq -r --arg me "$me" --arg since "$since" --arg key "$key" --arg summary "$summary" \
				'.worklogs | '"$my_worklogs") || die "could not fetch the worklogs of $key"
	done <<<"$incomplete"

	grep -v '^$' <<<"$records" || true
}

# Lists the time you logged per day and ticket over the last <days> days, today included.
worklog() {
	local days="${1:-7}"
	[[ "$days" =~ ^[0-9]+$ ]] && ((days > 0)) || die "not a number of days: $days"

	local since records
	since=$(date -v-"$((days - 1))"d +%Y-%m-%d)
	records=$(worklog_records "$since") || exit 1
	[[ -n "$records" ]] || { echo "No time logged since $since."; return 0; }

	sort -t$'\t' -k1.5,1 -k2,2 <<<"$records" | awk -F'\t' '
		function duration(s) { return sprintf("%2dh %02dm", int(s / 3600), int(s % 3600 / 60)) }
		function end_ticket() {
			if (key == "") return
			lines = lines sprintf("  %-9s %s  %s\n", key, duration(ticket_sum), summary)
			day_sum += ticket_sum
		}
		function end_day() {
			end_ticket()
			if (day == "") return
			printf "%s%s  %s\n%s", (total ? "\n" : ""), day, duration(day_sum), lines
			total += day_sum
		}
		$1 != day { end_day(); day = $1; key = ""; lines = ""; day_sum = 0 }
		$2 != key { end_ticket(); key = $2; summary = $4; ticket_sum = 0 }
		{ ticket_sum += $3 }
		END { end_day(); printf "\nTotal          %s\n", duration(total) }'
}

# Prints the total time you logged today, e.g. "3h 15m", and stores it as
# "<fetched epoch>\t<day>\t<total>" in $TODAY_FILE.
today() {
	local fetched day records total
	read -r fetched day < <(date '+%s %Y-%m-%d')
	records=$(worklog_records "$day") || exit 1
	total=$(awk -F'\t' '{ s += $3 } END { printf "%dh %02dm", int(s / 3600), int(s % 3600 / 60) }' <<<"$records")

	mkdir -p "$(dirname "$TODAY_FILE")"
	printf '%s\t%s\t%s\n' "$fetched" "$day" "$total" >"$TODAY_FILE.tmp"
	mv "$TODAY_FILE.tmp" "$TODAY_FILE"
	echo "$total"
}

# For the tmux status bar: prints the stored total of today with its dimmed age, e.g.
# "3h 15m ↻4m", or a dimmed "…" until there is one. Once it is older than $TODAY_TTL
# seconds, starts a refresh in the background; failed refreshes are retried after the
# same delay. Spawns only `date` otherwise, as this runs every few seconds.
today_tmux() {
	local now day fetched=0 stored_day="" total="" attempted=0
	read -r now day < <(date '+%s %Y-%m-%d')
	[[ -f "$TODAY_FILE" ]] && IFS=$'\t' read -r fetched stored_day total <"$TODAY_FILE"
	[[ -f "$TODAY_FILE.attempt" ]] && read -r attempted <"$TODAY_FILE.attempt"

	if [[ "$stored_day" != "$day" ]] || ((now - fetched >= TODAY_TTL)); then
		if ((now - attempted >= TODAY_TTL)); then
			mkdir -p "$(dirname "$TODAY_FILE")"
			echo "$now" >"$TODAY_FILE.attempt"
			# Detached from tmux's pipe, so tmux does not wait for the fetch.
			nohup "${BASH_SOURCE[0]}" today </dev/null >/dev/null 2>&1 &
		fi
	fi

	if [[ "$stored_day" != "$day" ]]; then
		echo '#[dim]…#[nodim]'
		return 0
	fi
	local age=$(((now - fetched) / 60)) unit=m
	if ((age >= 60 * 24)); then
		age=$((age / 60 / 24)) unit=d
	elif ((age >= 60)); then
		age=$((age / 60)) unit=h
	fi
	echo "$total #[dim]↻$age$unit#[nodim]"
}

# --- clean -------------------------------------------------------------------

clean() {
	local current_session=""
	if [[ -n "${TMUX:-}" ]]; then
		current_session=$(tmux display-message -p '#S')
	fi

	# One line per ts worktree: hidden "<order>\t<path>\t<branch>\t" fields, then the
	# visible text. Worktrees whose ticket is no longer among the stored tickets come first.
	local candidates="" path branch name key status notes order
	while IFS=$'\t' read -r path branch; do
		name="${branch#ts/}"
		key="TS-${name%%_*}"
		status=$(stored_status "$key")
		notes=""
		[[ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]] && notes+=" modified"
		[[ -n "$(git -C "$MAIN_REPO" log --oneline "$branch" --not --remotes)" ]] && notes+=" unpushed"
		if [[ -n "$status" ]]; then order=1; status="[$status]"; else order=0; status="[not in your tickets]"; fi
		candidates+="$order"$'\t'"$path"$'\t'"$branch"$'\t'"$(printf '%-9s %-24s %-40s%s' "$key" "$status" "$name" "$notes")"$'\n'
	done < <(git -C "$MAIN_REPO" worktree list --porcelain | awk '
		/^worktree / { path = substr($0, 10) }
		/^branch refs\/heads\/ts\// { print path "\t" substr($0, 19) }')

	[[ -n "$candidates" ]] || { echo "No ts worktrees to clean."; return 0; }

	local selection
	selection=$(printf '%s' "$candidates" | sort -t$'\t' -k1,1 -s | fzf --multi \
		--prompt='clean> ' --height=40% --reverse --delimiter=$'\t' --with-nth=4.. \
		--header='tab: select, enter: remove selected · modified/unpushed ones are kept') || exit 0

	local count answer
	count=$(wc -l <<<"$selection" | tr -d ' ')
	read -r -p "Remove $count worktree(s) with their branch and tmux session? [y/N] " answer
	[[ "$answer" == [yY] ]] || exit 0

	while IFS=$'\t' read -r order path branch _; do
		name=$(basename "$path")
		if [[ "$PWD" == "$path" || "$PWD" == "$path"/* ]]; then
			echo "Skipping $name: you are inside it"
			continue
		fi
		# Only delete branches whose commits all exist on a remote, so no work is lost.
		if [[ -n "$(git -C "$MAIN_REPO" log --oneline "$branch" --not --remotes)" ]]; then
			echo "Skipping $name: $branch has commits that are not pushed"
			continue
		fi
		if ! git -C "$MAIN_REPO" worktree remove "$path"; then
			echo "Skipping $name: could not remove the worktree"
			continue
		fi
		git -C "$MAIN_REPO" branch -D "$branch" >/dev/null
		if [[ "$name" == "$current_session" ]]; then
			echo "Removed $name; kill its tmux session yourself after switching away"
		else
			tmux kill-session -t "=$name" 2>/dev/null || true
			echo "Removed $name"
		fi
	done <<<"$selection"
	echo "Close their IntelliJ windows and Fork tabs yourself."
}

# --- main feature ------------------------------------------------------------

# Prints the picker lines: a hidden "<key>\t" field, then the visible text.
# Tickets that already have a worktree are marked.
ticket_listing() {
	local worktrees key status summary marker
	worktrees=$(git -C "$MAIN_REPO" worktree list --porcelain)
	printf 'master\t● %-9s %-16s %s\n' "master" "[main]" "$MAIN_REPO"
	while IFS=$'\t' read -r key status summary; do
		marker=" "
		[[ -n "$(find_worktree "${key#*-}" <<<"$worktrees")" ]] && marker="●"
		printf '%s\t%s %-9s %-16s %s\n' "$key" "$marker" "$key" "[$status]" "$summary"
	done <"$TICKETS_FILE"
}

picker_header() {
	echo "● = worktree exists · ctrl-o: open in Jira · ctrl-r: refresh · fetched $(stat -f '%Sm' -t '%a %H:%M' "$TICKETS_FILE")"
}

# Used by ctrl-r in the picker: fetches, then prints the new header.
refresh_header() {
	# Subshell, because fetch exits the script on errors.
	if (fetch) >/dev/null 2>&1; then
		picker_header
	else
		echo "Refresh failed, run 'ts healthcheck' · $(picker_header)"
	fi
}

pick() {
	if [[ ! -s "$TICKETS_FILE" ]]; then
		echo "No stored tickets yet, fetching them from Jira..."
		fetch
	fi

	local self url selection
	self=$(printf '%q' "${BASH_SOURCE[0]}")
	url=$(printf '%q' "$JIRA_URL")
	selection=$(ticket_listing | fzf --prompt='ticket> ' --height=40% --reverse \
		--delimiter=$'\t' --with-nth=2.. --header="$(picker_header)" \
		--bind "ctrl-o:execute-silent([ {1} = master ] || open $url/browse/{1})" \
		--bind "ctrl-r:transform-header($self _refresh-header)+reload($self _listing)") || exit 0

	local key="${selection%%$'\t'*}"
	if [[ "$key" == master ]]; then
		open_workspace "$MAIN_REPO" master
	else
		start "$key"
	fi
}

# Creates or reuses the worktree, tmux session, Fork tab and IntelliJ window of a ticket.
start() {
	local key="$1"
	local number="${key#*-}"

	# 1. Worktree

	local worktree
	worktree=$(find_worktree "$number" <<<"$(git -C "$MAIN_REPO" worktree list --porcelain)")
	if [[ -n "$worktree" ]]; then
		echo "Reusing worktree $worktree"
	else
		local summary
		summary=$([[ -f "$TICKETS_FILE" ]] && awk -F'\t' -v k="$key" '$1 == k { print $3 }' "$TICKETS_FILE" || true)
		if [[ -z "$summary" ]]; then
			require_jira_credentials
			summary=$(jira_curl -fsS "$JIRA_URL/rest/api/3/issue/$key?fields=summary" | jq -r '.fields.summary') \
				|| die "could not find $key in Jira"
		fi

		local default_name short_name
		default_name=$(slugify "$summary")
		read -r -p "Short name for $key ($summary) [$default_name]: " short_name
		short_name="${short_name:-$default_name}"
		short_name=$(echo "$short_name" | tr '[:upper:] -' '[:lower:]__')
		[[ "$short_name" =~ ^[a-z0-9_]+$ ]] || die "short name may only contain a-z, 0-9 and _"

		local name="${number}_${short_name}"
		local branch="ts/$name"
		worktree="$WORKTREES_DIR/$name"

		echo "Fetching origin/master..."
		git -C "$MAIN_REPO" fetch origin master
		if git -C "$MAIN_REPO" show-ref --verify --quiet "refs/heads/$branch"; then
			git -C "$MAIN_REPO" worktree add "$worktree" "$branch"
		else
			git -C "$MAIN_REPO" worktree add --no-track -b "$branch" "$worktree" origin/master
		fi
	fi

	open_workspace "$worktree" "$(basename "$worktree")"
}

# Creates or reuses the tmux session, Fork tab and IntelliJ window of a folder.
open_workspace() {
	local worktree="$1" session="$2"

	# tmux session

	if tmux has-session -t "=$session" 2>/dev/null; then
		echo "Reusing tmux session $session"
	else
		tmux new-session -d -s "$session" -c "$worktree"
		tmux split-window -h -t "=$session:" -c "$worktree"
		tmux select-pane -t "=$session:.0"
	fi

	# Fork, then IntelliJ last

	fork -C "$worktree" open >/dev/null 2>&1 || echo "ts: could not open Fork" >&2
	idea "$worktree" >/dev/null 2>&1 &

	if [[ -n "${TMUX:-}" ]]; then
		tmux switch-client -t "=$session"
	else
		tmux attach-session -t "=$session"
	fi
}

case "${1:-}" in
	"") pick ;;
	fetch) fetch ;;
	master) open_workspace "$MAIN_REPO" master ;;
	open) open_ticket "${2:-}" ;;
	time) worklog "${2:-}" ;;
	today)
		case "${2:-}" in
			"") today ;;
			--tmux) today_tmux ;;
			*) die "unknown option for today: $2" ;;
		esac
		;;
	clean) clean ;;
	healthcheck) healthcheck ;;
	help | -h | --help) usage ;;
	# Internal, used by the picker's key bindings.
	_listing) ticket_listing ;;
	_refresh-header) refresh_header ;;
	*)
		if key=$(parse_key "$1"); then
			start "$key"
		else
			usage >&2; echo >&2; die "unknown command '$1'"
		fi
		;;
esac
